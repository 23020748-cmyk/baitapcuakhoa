<?xml version="1.0"?>
<package format="3">
  <name>turtlebot4_slam_nav2</name>
  <version>0.1.0</version>
  <description>Launch wrappers for TurtleBot 4 simulation, SLAM mapping, localization, and Nav2.</description>
  <maintainer email="khoa@example.com">Lục Văn Khoa</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlebot4_ignition_bringup</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>
  <exec_depend>turtlebot4_viz</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
