<?xml version="1.0"?>
<window>
  <width>640</width><height>480</height>
</window>
<plugin filename="GzScene3D" name="3D View">
  <ignition-gui>
    <title>TurtleBot 4 - Gazebo</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </ignition-gui>
  <engine>ogre</engine>
  <scene>scene</scene>
  <ambient_light>0.7 0.7 0.7</ambient_light>
  <background_color>0.25 0.25 0.25</background_color>
  <camera_pose>3 -4 4 0 0.65 2.15</camera_pose>
</plugin>
<plugin filename="WorldControl" name="World control">
  <ignition-gui>
    <title>Play / Pause</title>
    <property type="string" key="state">floating</property>
    <property type="bool" key="showTitleBar">false</property>
    <property type="double" key="height">72</property>
    <property type="double" key="width">121</property>
    <anchors target="3D View">
      <line own="left" target="left"/><line own="bottom" target="bottom"/>
    </anchors>
  </ignition-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
